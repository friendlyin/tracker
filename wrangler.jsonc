{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "health-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    // React PWA is served as static assets; unknown paths fall back to index.html.
    "not_found_handling": "single-page-application",
    // These paths always hit the Worker first (API, auth, MCP).
    "run_worker_first": [
      "/api/*",
      "/mcp*",
      "/authorize*",
      "/token*",
      "/register*",
      "/callback*",
      "/.well-known/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "health-db",
      // No database_id on purpose: `wrangler deploy` creates the database on first deploy and reuses it
      // afterwards, so no account-specific ids live in this public repo (see docs/cloudflare-setup.md).
      "migrations_dir": "migrations"
    }
  ]
}
